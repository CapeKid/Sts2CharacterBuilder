{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "atlas",
    "width",
    "height",
    "scale_percent",
    "filter",
    "frames",
    "states"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "atlas": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "scale_percent": {
      "type": "integer",
      "minimum": 10,
      "maximum": 400
    },
    "filter": {
      "type": "string",
      "enum": [
        "nearest",
        "linear"
      ]
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rect",
          "anchor"
        ],
        "properties": {
          "rect": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            }
          },
          "anchor": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            }
          }
        }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idle",
        "attack",
        "skill",
        "hurt",
        "death",
        "victory"
      ],
      "properties": {
        "idle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fps",
            "frames"
          ],
          "properties": {
            "fps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "attack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fps",
            "frames"
          ],
          "properties": {
            "fps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fps",
            "frames"
          ],
          "properties": {
            "fps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "hurt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fps",
            "frames"
          ],
          "properties": {
            "fps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "death": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fps",
            "frames"
          ],
          "properties": {
            "fps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "victory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fps",
            "frames"
          ],
          "properties": {
            "fps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      }
    }
  }
}
