{
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "scenarios": {"type": "array", "maxItems": 6, "items": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "[A-Za-z][A-Za-z0-9_]{1,47}"},
        "seed": {"type": "string", "pattern": "[A-Za-z0-9_-]{1,64}"},
        "encounter": {"type": "string", "enum": ["NibbitsNormal"]},
        "ascension": {"type": "integer", "enum": [0]},
        "policy": {"type": "string", "enum": ["priority-lowest-hp"]},
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_plays": {"type": "integer", "minimum": 1, "maximum": 60},
        "deck": {"type": "array", "minItems": 1, "maxItems": 30, "items": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "card": {"type": "string", "pattern": "[A-Za-z][A-Za-z0-9_]{1,47}"},
            "upgraded": {"type": "boolean"}
          }, "required": ["card", "upgraded"]
        }},
        "priority": {"type": "array", "minItems": 1, "maxItems": 30,
          "items": {"type": "string", "pattern": "[A-Za-z][A-Za-z0-9_]{1,47}"}}
      },
      "required": ["id", "seed", "encounter", "ascension", "policy", "max_turns", "max_plays", "deck", "priority"]
    }}
  }, "required": ["schema_version", "scenarios"]
}
